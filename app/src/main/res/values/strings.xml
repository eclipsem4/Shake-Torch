    <string name="oem_tips_title">Device Manufacturer Tips</string>
    <string name="oem_tips_subtitle">Some brands aggressively stop background services. Follow your device guide if ShakeLight stops after locking.</string>
    <string name="oem_xiaomi_title">Xiaomi (MIUI / HyperOS)</string>
    <string name="oem_xiaomi_body">Security app -&gt; Permissions -&gt; Autostart -&gt; Enable ShakeLight. Also set Battery Saver to "No restrictions" in App Info.</string>
    <string name="oem_oppo_title">Oppo &amp; Realme (ColorOS)</string>
    <string name="oem_oppo_body">Settings -&gt; Apps -&gt; App Management -&gt; ShakeLight -&gt; Battery usage -&gt; Enable "Allow background activity" and "Allow auto launch".</string>
    <string name="oem_vivo_title">Vivo &amp; iQOO (FuntouchOS)</string>
    <string name="oem_vivo_body">iManager -&gt; App Manager -&gt; Autostart manager -&gt; Allow ShakeLight, and set Background power consumption to "High background power usage".</string>
    <string name="oem_samsung_title">Samsung (One UI)</string>
    <string name="oem_samsung_body">Settings -&gt; Apps -&gt; ShakeLight -&gt; Battery -&gt; Select "Unrestricted", and remove ShakeLight from Sleeping / Deep Sleeping apps.</string>

